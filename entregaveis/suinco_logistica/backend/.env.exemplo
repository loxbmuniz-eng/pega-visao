# =====================================================================
# EMBARQUE SUINCO — configuração do servidor
# ---------------------------------------------------------------------
# Copie para `.env` e preencha. O `.env` NUNCA vai para o Git (está no
# .gitignore) — é o único lugar onde segredo deve existir.
#
# O instalar.sh gera este arquivo sozinho, com senha e segredos aleatórios.
# Só mexa aqui se precisar mudar algo depois.
# =====================================================================

NODE_ENV=production

# A API escuta só em 127.0.0.1. Quem fala com a internet é o Nginx.
# Nunca troque para 0.0.0.0: isso expõe a API sem HTTPS nem rate limit.
PORT=3000

# --- Banco -----------------------------------------------------------
# O PostgreSQL fica em localhost, no mesmo servidor. A porta 5432 NÃO deve
# estar aberta no firewall. Banco exposto na internet é o caminho mais
# curto para o vazamento.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=embarque_suinco
PGUSER=suinco
PGPASSWORD=

# --- Segurança -------------------------------------------------------
# Mínimo 32 caracteres. Gere com:  openssl rand -base64 48
# Trocar este valor desloga todo mundo na hora — é o botão de emergência
# se um token vazar.
JWT_SECRET=

# Turno de pátio é longo; 12h evita deslogar o operador no meio.
JWT_VALIDADE=12h

# --- Origens autorizadas (CORS) --------------------------------------
# Só estes endereços podem chamar a API pelo navegador. Separe por vírgula.
# Nunca use "*": qualquer site poderia chamar a API com o token do operador.
ORIGENS_PERMITIDAS=https://embarquesuinco.com.br,https://www.embarquesuinco.com.br

# --- Power BI --------------------------------------------------------
# Token de LEITURA das views. Deixe vazio para desligar o /bi por completo.
# Gere com:  openssl rand -hex 32
BI_TOKEN=

# --- Robô do WhatsApp (n8n) ------------------------------------------
# Token de LEITURA usado pela automação que manda o resumo do carregamento
# no grupo de 3 em 3 horas (rotas /bot/*). Não é login de operador: só lê,
# não escreve nada. Deixe vazio para desligar o /bot por completo.
# Gere com:  openssl rand -hex 32
BOT_TOKEN=

# --- Limites ---------------------------------------------------------
# Requisições por minuto, por IP. O pátio inteiro em hora de pico faz muito
# menos que isso — o teto existe para conter script, não operador.
RATE_LIMIT=300

# Logins por minuto, por IP. Atenção: o pátio inteiro costuma sair pelo
# MESMO IP, então este número precisa caber numa troca de turno com várias
# pessoas entrando junto. Com 10, as últimas veem "muitas tentativas" e
# acham que erraram a senha.
RATE_LIMIT_LOGIN=30

# --- Fechamento de programação ---------------------------------------
# Senha para ENCERRAR a programação quando ainda existe carga em aberto
# (pedido do usuário, 11/08/2026). Pátio limpo fecha sem senha nenhuma.
# Deixe vazio para que ninguém consiga fechar com carga em andamento.
# A carga em aberto NÃO some da Torre — ela só passa a pertencer à
# programação arquivada. Fechar nunca apaga carga.
SENHA_FECHAMENTO=
